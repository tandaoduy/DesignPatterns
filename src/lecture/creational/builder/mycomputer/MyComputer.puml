@startuml
'https://plantuml.com/class-diagram

class Builder{
   - String cpu, ram, storage, screen
   + Builder buildCPU(String cpu);
   + Builder buildRAM(String ram);
   + Builder buildStorage(String storage);
   + Builder buildScreen(Sring screen);
}
class Computer{
    - String cpu, ram, storage, screen
    - Computer(Builder b)
}
Builder ..> Computer
@enduml