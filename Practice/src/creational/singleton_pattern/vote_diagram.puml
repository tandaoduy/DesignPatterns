@startuml
'https://plantuml.com/class-diagram
'để singleton có 1 biến instance kiểu static'
'hàm khởi tạo election
'hàm get public'

enum Candidate{
    DONANL_TRUMP, JOE_BIDEN
}
class Election{
    - {static} Election instance
    - int trump, biden
    - List <String> voteUser
    - Election()
    + {static} Election getInstance()
    # void vote(Candidate c, String UserId)
    + void printResult()
}
class Usser{
    -String id
    + void vote(Candidate c)
    }
'mỗi đối tượng người dùng phải chứa election'
Usser ..> Election
@enduml